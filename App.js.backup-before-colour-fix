}

function Cover({ uri, title, size = "normal" }) {
  const dimensions =
    size === "large"
      ? { width: 112, height: 166 }
      : size === "small"
      ? { width: 52, height: 76 }
      : { width: 72, height: 106 };

  if (uri) {
    return (
      <Image
        source={{ uri }}
        resizeMode="cover"
        style={[styles.coverImage, dimensions]}
      />
    );
  }

  return (
    <View style={[styles.coverFallback, dimensions]}>
      <View style={styles.coverFallbackRule} />
      <Text style={styles.coverFallbackTitle} numberOfLines={5}>
        {title || "Untitled"}
      </Text>
      <View style={styles.coverFallbackRule} />
    </View>
  );
}

function Chip({ label, selected, onPress }) {
  return (
    <Pressable
      onPress={onPress}
      style={[styles.chip, selected && styles.chipSelected]}
    >
      <Text style={[styles.chipText, selected && styles.chipTextSelected]}>
        {label}
      </Text>
    </Pressable>
  );
}

function Bookshelf({ items, onBookPress, seriesByBook }) {
  const [display, setDisplay] = useState("Covers");

  const grouped = useMemo(() => {
    const groups = new Map();

    items.forEach(item => {
      const id = bookId(item);
      const series = seriesByBook[id];
      const name = series?.name || "Standalone books";

      if (!groups.has(name)) groups.set(name, []);
      groups.get(name).push({
        ...item,
        _readingOrder: Number(series?.reading_order || 999),
      });
    });

    return Array.from(groups.entries())
      .map(([name, books]) => ({
        name,
        books: books.sort((a, b) => {
          if (a._readingOrder !== b._readingOrder) {
            return a._readingOrder - b._readingOrder;
          }
          return String(a.title).localeCompare(String(b.title));
        }),
      }))
      .sort((a, b) => {
        if (a.name === "Standalone books") return 1;
        if (b.name === "Standalone books") return -1;
        return a.name.localeCompare(b.name);
      });
  }, [items, seriesByBook]);

  if (!items.length) {
    return (
      <View style={styles.emptyState}>
        <Text style={styles.emptyMark}>✦</Text>
        <Text style={styles.emptyTitle}>A shelf waiting to be filled</Text>
        <Text style={styles.emptyText}>
          Add your first book and begin building your collection.
        </Text>
      </View>
    );
  }

  return (
    <View>
      <View style={styles.shelfToolbar}>
        <Text style={styles.toolbarLabel}>SHELF DISPLAY</Text>
        <View style={styles.chipRow}>
          {["Covers", "Spines"].map(option => (
            <Chip
              key={option}
              label={option}
              selected={display === option}
              onPress={() => setDisplay(option)}
            />
          ))}
        </View>
      </View>

      {grouped.map(group => (
        <View key={group.name} style={styles.shelfGroup}>
          <View style={styles.shelfGroupHeader}>
            <Text style={styles.shelfGroupName}>{group.name}</Text>
            <Text style={styles.shelfGroupCount}>
              {group.books.length} {group.books.length === 1 ? "BOOK" : "BOOKS"}
            </Text>
          </View>

          <View style={styles.shelfSurface}>
            <View style={styles.shelfBooks}>
              {group.books.map((item, index) => {
                const edition = item.editionRecord;
                const cover =
                  edition?.cover_url ||
                  item.cover_url ||
                  item.bookRecord?.cover_url;
                const spine =
                  edition?.spine_image_url ||
                  item.spine_image_url ||
                  item.bookRecord?.spine_image_url;

                return (
                  <Pressable
                    key={`${bookId(item)}-${edition?.id || index}`}
                    onPress={() => onBookPress(item)}
                    style={[
                      styles.shelfBook,
                      display === "Spines" && styles.shelfBookSpine,
                    ]}
                  >
                    {display === "Spines" ? (
                      spine ? (
                        <Image
                          source={{ uri: spine }}
                          resizeMode="stretch"
                          style={styles.spineImage}
                        />
                      ) : (
                        <View style={styles.spineFallback}>
                          <View style={styles.spineRule} />
                          <Text style={styles.spineTitle} numberOfLines={5}>
                            {item.title}
                          </Text>
                          <View style={styles.spineRule} />
                        </View>
                      )
                    ) : (
                      <Cover uri={cover} title={item.title} />
                    )}
                    {display === "Covers" && (
                      <Text style={styles.shelfBookCaption} numberOfLines={2}>
                        {item.title}
                      </Text>
                    )}
                  </Pressable>
                );
              })}
            </View>
            <View style={styles.shelfPlank}>
              <View style={styles.shelfPlankHighlight} />
            </View>
          </View>
        </View>
      ))}
    </View>
  );
}

export default function App() {
  const [session, setSession] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  const [tab, setTab] = useState("Library");
  const [search, setSearch] = useState("");

  const [books, setBooks] = useState([]);
  const [editions, setEditions] = useState([]);
  const [physicalCopies, setPhysicalCopies] = useState([]);
  const [tbrIds, setTbrIds] = useState([]);
  const [dnfIds, setDnfIds] = useState([]);
  const [preorders, setPreorders] = useState([]);
  const [collections, setCollections] = useState([]);
  const [collectionBooks, setCollectionBooks] = useState([]);
  const [universes, setUniverses] = useState([]);
  const [series, setSeries] = useState([]);
  const [seriesBooks, setSeriesBooks] = useState([]);
  const [subscriptions, setSubscriptions] = useState([]);
  const [subscriptionBooks, setSubscriptionBooks] = useState([]);

  const [selectedBook, setSelectedBook] = useState(null);
  const [selectedCollection, setSelectedCollection] = useState(null);
  const [selectedUniverse, setSelectedUniverse] = useState(null);
  const [selectedSeries, setSelectedSeries] = useState(null);
  const [selectedSubscription, setSelectedSubscription] = useState(null);

  const [modal, setModal] = useState("");
  const [editingId, setEditingId] = useState(null);
  const [editingEditionId, setEditingEditionId] = useState(null);

  const [bookForm, setBookForm] = useState({
    title: "",
    author: "",
    description: "",
    genre: "",
    cover_url: "",
    edition_name: "",
    format: "Hardback",
    isbn: "",
    publisher: "",
    publication_year: "",
    edition_cover_url: "",
    spine_image_url: "",
    sprayed_edge_url: "",
    signed: false,
    special_features: "",
    condition: "Good",
    copy_notes: "",
    on_tbr: false,
  });

  const [collectionForm, setCollectionForm] = useState({
    name: "",
    description: "",
  });

  const [universeForm, setUniverseForm] = useState({
    name: "",
    description: "",
  });

  const [seriesForm, setSeriesForm] = useState({
    name: "",
    description: "",
    universe_id: "",
  });

  const [preForm, setPreForm] = useState({
    title: "",
    author: "",
    cover_url: "",
    format: "Hardback",
    isbn: "",
    retailer: "",
    price: "",
    shipping_cost: "",
    currency: "GBP",
    order_date: displayDate(todayISO()),
    expected_shipping_month: "",
    expected_shipping_year: "",
    notes: "",
  });

  const [subscriptionForm, setSubscriptionForm] = useState({
    name: "",
    provider: "",
    price: "",
    currency: "GBP",
    renewal_date: "",
    status: "Active",
    notes: "",
  });

  const [monthlyBookForm, setMonthlyBookForm] = useState({
    title: "",
    author: "",
    edition_name: "",
    cover_url: "",
    month: String(new Date().getMonth() + 1),
    year: String(new Date().getFullYear()),
  });

  const userId = session?.user?.id;

  useEffect(() => {
    let active = true;

    supabase.auth.getSession().then(({ data, error: authError }) => {
      if (!active) return;
      if (authError) setError(authError.message);
      setSession(data?.session || null);
      setAuthLoading(false);
    });

    const { data: authListener } = supabase.auth.onAuthStateChange(
      (_event, nextSession) => setSession(nextSession)
    );

    return () => {
      active = false;
      authListener?.subscription?.unsubscribe();
    };
  }, []);

  const loadTable = useCallback(async (table, configure) => {
    let query = supabase.from(table).select("*");
    if (configure) query = configure(query);
    const { data, error: queryError } = await query;
    if (queryError) throw queryError;
    return data || [];
  }, []);

  const loadData = useCallback(async () => {
    if (!userId) return;

    setLoading(true);
    setError("");

    try {
      const results = await Promise.all([
        loadTable("books", q => q.eq("user_id", userId).order("title")),
        loadTable("editions", q => q.eq("user_id", userId)),
        loadTable("physical_copies", q => q.eq("user_id", userId)),
        loadTable("tbr_books", q => q.eq("user_id", userId)),
        loadTable("dnf_books", q => q.eq("user_id", userId)),
        loadTable("preorders", q =>
          q.eq("user_id", userId).order("created_at", { ascending: false })
        ),
        loadTable("collections", q => q.eq("user_id", userId).order("name")),
        loadTable("collection_books", q => q.eq("user_id", userId)),
        loadTable("universes", q => q.eq("user_id", userId).order("name")),
        loadTable("series", q => q.eq("user_id", userId).order("name")),
        loadTable("series_books", q => q.eq("user_id", userId)),
        loadTable("subscriptions", q => q.eq("user_id", userId).order("name")),
        loadTable("subscription_books", q => q.eq("user_id", userId)),
      ]);

      const [
        bookRows,
        editionRows,
        copyRows,
        tbrRows,
        dnfRows,
        preorderRows,
        collectionRows,
        collectionBookRows,
        universeRows,
        seriesRows,
        seriesBookRows,
        subscriptionRows,
        subscriptionBookRows,
      ] = results;

      setBooks(bookRows);
      setEditions(editionRows);
      setPhysicalCopies(copyRows);
      setTbrIds(tbrRows.map(row => row.book_id));
      setDnfIds(dnfRows.map(row => row.book_id));
      setPreorders(preorderRows);
      setCollections(collectionRows);
      setCollectionBooks(collectionBookRows);
      setUniverses(universeRows);
      setSeries(seriesRows);
      setSeriesBooks(seriesBookRows);
      setSubscriptions(subscriptionRows);
      setSubscriptionBooks(subscriptionBookRows);
    } catch (e) {
      setError(e.message || "Unable to load Folio data.");
    } finally {
      setLoading(false);
    }
  }, [userId, loadTable]);

  useEffect(() => {
    if (userId) loadData();
  }, [userId, loadData]);

  const seriesByBook = useMemo(() => {
    const result = {};
    seriesBooks.forEach(link => {
      const found = series.find(s => s.id === link.series_id);
      if (found) {
        result[link.book_id] = {
          ...found,
          reading_order: link.reading_order,
        };
      }
    });
    return result;
  }, [seriesBooks, series]);

  const libraryItems = useMemo(() => {
    return books.flatMap(book => {
      const bookEditions = editions.filter(e => e.book_id === book.id);
      const common = {
        ...book,
        book_id: book.id,
        bookRecord: book,
        isTbr: tbrIds.includes(book.id),
        isDnf: dnfIds.includes(book.id),
      };

      if (!bookEditions.length) return [common];

      return bookEditions.map(edition => ({
        ...common,
        id: `${book.id}-${edition.id}`,
        editionRecord: edition,
        cover_url: edition.cover_url || book.cover_url,
      }));
    });
  }, [books, editions, tbrIds, dnfIds]);

  const visibleItems = useMemo(() => {
    const query = search.trim().toLowerCase();

    return libraryItems.filter(item => {
      const id = bookId(item);

      if (tab === "TBR" && !tbrIds.includes(id)) return false;
      if (tab === "DNF" && !dnfIds.includes(id)) return false;
      if (!query) return true;

      return [
        item.title,
        item.author,
        item.genre,
        item.editionRecord?.edition_name,
        item.editionRecord?.format,
      ]
        .join(" ")
        .toLowerCase()
        .includes(query);
    });
  }, [libraryItems, search, tab, tbrIds, dnfIds]);

  const resetBookForm = () => ({
    title: "",
    author: "",
    description: "",
    genre: "",
    cover_url: "",
    edition_name: "",
    format: "Hardback",
    isbn: "",
    publisher: "",
    publication_year: "",
    edition_cover_url: "",
    spine_image_url: "",
    sprayed_edge_url: "",
    signed: false,
    special_features: "",
    condition: "Good",
    copy_notes: "",
    on_tbr: false,
  });

  const openNewBook = () => {
    setEditingId(null);
    setEditingEditionId(null);
    setBookForm(resetBookForm());
    setModal("book");
  };

  const openEditBook = item => {
    const id = bookId(item);
    const record = books.find(b => b.id === id);
    if (!record) return;

    const edition =
      item.editionRecord ||
      editions.find(e => e.book_id === id) ||
      null;

    setEditingId(id);
    setEditingEditionId(edition?.id || null);
    setBookForm({
      title: record.title || "",
      author: record.author || "",
      description: record.description || "",
      genre: record.genre || "",
      cover_url: record.cover_url || "",
      edition_name: edition?.edition_name || "",
      format: edition?.format || "Hardback",
      isbn: edition?.isbn || "",
      publisher: edition?.publisher || "",
      publication_year: edition?.publication_date?.slice(0, 4) || "",
      edition_cover_url: edition?.cover_url || "",
      spine_image_url: edition?.spine_image_url || "",
      sprayed_edge_url: edition?.sprayed_edge_url || "",
      signed: !!edition?.signed,
      special_features: edition?.special_features || "",
      condition: "Good",
      copy_notes: "",
      on_tbr: tbrIds.includes(id),
    });
    setModal("book");
  };

  const saveBook = async () => {
    if (!bookForm.title.trim()) {
      Alert.alert("Title required", "Please enter a book title.");
      return;
    }

    setSaving(true);

    try {
      let id = editingId;

      const bookPayload = {
        user_id: userId,
        title: bookForm.title.trim(),
        author: bookForm.author.trim() || null,
        description: bookForm.description.trim() || null,
        genre: bookForm.genre.trim() || null,
        cover_url: bookForm.cover_url.trim() || null,
        updated_at: new Date().toISOString(),
      };

      if (id) {
        const { error: bookError } = await supabase
          .from("books")
          .update(bookPayload)
          .eq("id", id)
          .eq("user_id", userId);

        if (bookError) throw bookError;
      } else {
        const { data, error: bookError } = await supabase
          .from("books")
          .insert(bookPayload)
          .select()
          .single();

        if (bookError) throw bookError;
        id = data.id;
      }

      const hasEditionDetails =
        bookForm.edition_name.trim() ||
        bookForm.isbn.trim() ||
        bookForm.format;

      if (hasEditionDetails) {
        const editionPayload = {
          user_id: userId,
          book_id: id,
          edition_name: bookForm.edition_name.trim() || null,
          format: bookForm.format || null,
          isbn: bookForm.isbn.trim() || null,
          publisher: bookForm.publisher.trim() || null,
          publication_date: bookForm.publication_year
            ? `${bookForm.publication_year}-01-01`
            : null,
          cover_url: bookForm.edition_cover_url.trim() || null,
          spine_image_url: bookForm.spine_image_url.trim() || null,
          sprayed_edge_url: bookForm.sprayed_edge_url.trim() || null,
          signed: !!bookForm.signed,
          special_features: bookForm.special_features.trim() || null,
          updated_at: new Date().toISOString(),
        };

        let editionId = editingEditionId;

        if (editionId) {
          const { error: editionError } = await supabase
            .from("editions")
            .update(editionPayload)
            .eq("id", editionId)
            .eq("user_id", userId);

          if (editionError) throw editionError;
        } else {
          const { data, error: editionError } = await supabase
            .from("editions")
            .insert(editionPayload)
            .select()
            .single();

          if (editionError) throw editionError;
          editionId = data.id;

          const { error: copyError } = await supabase
            .from("physical_copies")
            .insert({
              user_id: userId,
              edition_id: editionId,
              condition: bookForm.condition || null,
              signed: !!bookForm.signed,
              notes: bookForm.copy_notes.trim() || null,
            });

          if (copyError) throw copyError;
        }
      }

      if (bookForm.on_tbr && !tbrIds.includes(id)) {
        const { error: tbrError } = await supabase
          .from("tbr_books")
          .insert({ user_id: userId, book_id: id });

        if (tbrError) throw tbrError;
      } else if (!bookForm.on_tbr && tbrIds.includes(id)) {
        const { error: tbrError } = await supabase
          .from("tbr_books")
          .delete()
          .eq("user_id", userId)
          .eq("book_id", id);

        if (tbrError) throw tbrError;
      }

      setModal("");
      setSelectedBook(null);
      await loadData();
    } catch (e) {
      Alert.alert("Couldn't save book", e.message);
    } finally {
      setSaving(false);
    }
  };

  const addAnotherEdition = () => {
    if (!selectedBook) return;
    const record = books.find(b => b.id === bookId(selectedBook));
    if (!record) return;

    setEditingId(record.id);
    setEditingEditionId(null);
    setBookForm({
      ...resetBookForm(),
      title: record.title || "",
      author: record.author || "",
      description: record.description || "",
      genre: record.genre || "",
      cover_url: record.cover_url || "",
    });
    setModal("book");
  };

  const addPhysicalCopy = async edition => {
    try {
      const { error: copyError } = await supabase
        .from("physical_copies")
        .insert({
          user_id: userId,
          edition_id: edition.id,
          condition: "Good",
          signed: !!edition.signed,
        });

      if (copyError) throw copyError;
      await loadData();
      Alert.alert("Copy added", "A new physical copy has been recorded.");
    } catch (e) {
      Alert.alert("Couldn't add copy", e.message);
    }
  };

  const toggleList = async (id, list) => {
    const table = list === "TBR" ? "tbr_books" : "dnf_books";
    const current = list === "TBR" ? tbrIds : dnfIds;
    const exists = current.includes(id);

    try {
      const request = exists
        ? supabase
            .from(table)
            .delete()
            .eq("user_id", userId)
            .eq("book_id", id)
        : supabase.from(table).insert({ user_id: userId, book_id: id });

      const { error: changeError } = await request;
      if (changeError) throw changeError;
      await loadData();
    } catch (e) {
      Alert.alert("Couldn't update list", e.message);
    }
  };

  const addCollection = async () => {
    if (!collectionForm.name.trim()) return;

    try {
      const { error: insertError } = await supabase
        .from("collections")
        .insert({
          user_id: userId,
          name: collectionForm.name.trim(),
          description: collectionForm.description.trim() || null,
          collection_type: "standard",
        });

      if (insertError) throw insertError;
      setCollectionForm({ name: "", description: "" });
      setModal("");
      await loadData();
    } catch (e) {
      Alert.alert("Couldn't create collection", e.message);
    }
  };

  const addBookToCollection = async (id, collectionId) => {
