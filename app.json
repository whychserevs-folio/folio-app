{
  "expo": {
    "name": "folio-app",
    "slug": "folio-app",
    "scheme": "folioapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.whychoosereviews.folioapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Folio to use your camera to scan book barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Folio to access your photos so you can add book covers and edition photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3643c003-37bf-4f45-bd79-d4be474318b3"
      }
    }
  }
}
