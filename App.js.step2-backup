
import React, { useEffect, useMemo, useState } from "react";
import {
  View, Text, TextInput, TouchableOpacity, FlatList, Modal,
  ScrollView, Image, Alert, KeyboardAvoidingView, Platform,
  ActivityIndicator
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { CameraView, useCameraPermissions } from "expo-camera";
import { supabase } from "./src/supabase";
import AuthScreen from "./src/AuthScreen";
import Bookshelf from "./src/Bookshelf";

const C = {
  bg: "#101012",
  card: "#1C1B1E",
  ink: "#F0EBE7",
  muted: "#A39B9B",
  burgundy: "#702D3B",
  wine: "#3B2028",
  line: "#302C30",
};

const money = n =>
  new Intl.NumberFormat("en-GB", {
    style: "currency",
    currency: "GBP"
  }).format(Number(n) || 0);

function Action({ title, onPress, primary = false, small = false, disabled = false }) {
  return (
    <TouchableOpacity
      onPress={onPress}
      disabled={disabled}
      style={{
        backgroundColor: primary ? C.burgundy : C.card,
        paddingVertical: 11,
        paddingHorizontal: small ? 12 : 16,
        borderRadius: 16,
        alignItems: "center",
        opacity: disabled ? 0.5 : 1
      }}
    >
      <Text style={{ color: C.ink, fontWeight: "600", fontSize: small ? 12 : 14 }}>
        {title}
      </Text>
    </TouchableOpacity>
  );
}

function AddButton({ label, onPress }) {
  return (
    <View style={{
      position: "absolute",
      bottom: 14,
      left: 0,
      right: 0,
      alignItems: "center"
    }}>
      <TouchableOpacity
        onPress={onPress}
        style={{
          backgroundColor: C.burgundy,
          width: 58,
          height: 58,
          borderRadius: 29,
          alignItems: "center",
          justifyContent: "center",
          elevation: 4
        }}
      >
        <Text style={{ color: C.ink, fontSize: 32, lineHeight: 36 }}>+</Text>
      </TouchableOpacity>
      <Text style={{ fontSize: 10, color: C.muted, marginTop: 3 }}>
        {label}
      </Text>
    </View>
  );
}

function Field({ label, value, onChangeText, placeholder, keyboardType, multiline = false, autoCapitalize }) {
  return (
    <View style={{ marginBottom: 12 }}>
      <Text style={{ color: C.muted, fontSize: 12, marginBottom: 6 }}>
        {label}
      </Text>
      <TextInput
        value={value == null ? "" : String(value)}
        onChangeText={onChangeText}
        placeholder={placeholder || label}
        placeholderTextColor={C.muted}
        keyboardType={keyboardType}
        multiline={multiline}
        autoCapitalize={autoCapitalize}
        textAlignVertical={multiline ? "top" : "center"}
        style={{
          backgroundColor: C.bg,
          borderRadius: 12,
          padding: 12,
          minHeight: multiline ? 90 : 46,
          color: C.ink,
          borderWidth: 1,
          borderColor: C.line
        }}
      />
    </View>
  );
}

function Choice({ label, value, options, onChange }) {
  return (
    <View style={{ marginBottom: 14 }}>
      <Text style={{ color: C.muted, fontSize: 12, marginBottom: 7 }}>
        {label}
      </Text>
      <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 7 }}>
        {options.map(option => (
          <TouchableOpacity
            key={option}
            onPress={() => onChange(option)}
            style={{
              paddingVertical: 9,
              paddingHorizontal: 12,
              borderRadius: 15,
              backgroundColor: value === option ? C.burgundy : C.bg
            }}
          >
            <Text style={{ color: C.ink, fontSize: 12, fontWeight: "600" }}>
              {option}
            </Text>
          </TouchableOpacity>
        ))}
      </View>
    </View>
  );
}

function Cover({ uri, title, style }) {
  if (uri) {
    return (
      <Image
        source={{ uri }}
        resizeMode="cover"
        style={[{
          width: "100%",
          aspectRatio: 0.68,
          borderRadius: 9,
          backgroundColor: C.wine
        }, style]}
      />
    );
  }

  return (
    <View style={[{
      width: "100%",
      aspectRatio: 0.68,
      borderRadius: 9,
      backgroundColor: C.wine,
      alignItems: "center",
      justifyContent: "center",
      padding: 10
    }, style]}>
      <Text style={{ fontSize: 28 }}>ðŸ“–</Text>
      <Text numberOfLines={4} style={{
        color: C.ink,
        fontSize: 11,
        textAlign: "center",
        marginTop: 8
      }}>
        {title}
      </Text>
    </View>
  );
}

function cleanImageUrl(url) {
  if (!url) return "";
  return url.replace(/^http:\/\//i, "https://");
}

function getGoogleIsbn(volume) {
  const identifiers = volume?.industryIdentifiers || [];
  return (
    identifiers.find(x => x.type === "ISBN_13")?.identifier ||
    identifiers.find(x => x.type === "ISBN_10")?.identifier ||
    ""
  );
}

function googleCompleteness(volume) {
  if (!volume) return 0;

  let score = 0;
  if (volume.title) score += 2;
  if (volume.authors?.length) score += 3;
  if (volume.description) score += 3;
  if (getGoogleIsbn(volume)) score += 3;
  if (volume.publisher) score += 2;
  if (volume.publishedDate) score += 2;
  if (volume.categories?.length) score += 2;
  if (volume.imageLinks?.thumbnail || volume.imageLinks?.smallThumbnail) score += 2;

  return score;
}

export default function App() {
  const [session, setSession] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [loadError, setLoadError] = useState("");

  const [tab, setTab] = useState("Library");
  const [books, setBooks] = useState([]);
  const [editions, setEditions] = useState([]);
  const [tbrIds, setTbrIds] = useState([]);
  const [preorders, setPreorders] = useState([]);
  const [collections, setCollections] = useState([]);
  const [collectionBooks, setCollectionBooks] = useState([]);

  const [search, setSearch] = useState("");
  const [modal, setModal] = useState("");
  const [bookForm, setBookForm] = useState({});
  const [preForm, setPreForm] = useState({});
  const [collectionForm, setCollectionForm] = useState({});
  const [editingItem, setEditingItem] = useState(null);
  const [selectedItem, setSelectedItem] = useState(null);
  const [lookupBusy, setLookupBusy] = useState(false);
  const [lookupMessage, setLookupMessage] = useState("");

  // Barcode scanner
  const [cameraPermission, requestCameraPermission] = useCameraPermissions();
  const [scannerVisible, setScannerVisible] = useState(false);
  const [barcodeScanned, setBarcodeScanned] = useState(false);

  // Profile
  const [profile, setProfile] = useState(null);
  const [profileLoading, setProfileLoading] = useState(false);
  const [newUsername, setNewUsername] = useState("");
  const [usernameSaving, setUsernameSaving] = useState(false);

  const setBF = (key, value) =>
    setBookForm(previous => ({ ...previous, [key]: value }));

  const setPF = (key, value) =>
    setPreForm(previous => ({ ...previous, [key]: value }));

  const setCF = (key, value) =>
    setCollectionForm(previous => ({ ...previous, [key]: value }));

  useEffect(() => {
    let mounted = true;

    supabase.auth.getSession().then(({ data, error }) => {
      if (!mounted) return;
      if (error) console.log("Session error:", error.message);
      setSession(data?.session || null);
      setAuthLoading(false);
    });

    const { data: { subscription } } =
      supabase.auth.onAuthStateChange((_event, nextSession) => {
        setSession(nextSession);
        setAuthLoading(false);
      });

    return () => {
      mounted = false;
      subscription.unsubscribe();
    };
  }, []);

  async function loadData() {
    if (!session?.user?.id) return;

    setLoading(true);
    setLoadError("");

    try {
      const userId = session.user.id;

      const results = await Promise.all([
        supabase.from("books").select("*").eq("user_id", userId).order("created_at", { ascending: false }),
        supabase.from("editions").select("*").eq("user_id", userId).order("created_at", { ascending: false }),
        supabase.from("tbr_books").select("book_id").eq("user_id", userId),
        supabase.from("preorders").select("*").eq("user_id", userId).order("created_at", { ascending: false }),
        supabase.from("collections").select("*").eq("user_id", userId).order("created_at", { ascending: false }),
        supabase.from("collection_books").select("collection_id, book_id").eq("user_id", userId)
      ]);

      const labels = ["Books", "Editions", "TBR", "Pre-orders", "Collections", "Collection books"];
      const failed = results.findIndex(result => result.error);

      if (failed !== -1) {
        throw new Error(labels[failed] + ": " + results[failed].error.message);
      }

      setBooks(results[0].data || []);
      setEditions(results[1].data || []);
      setTbrIds((results[2].data || []).map(row => row.book_id));
      setPreorders(results[3].data || []);
      setCollections(results[4].data || []);
      setCollectionBooks(results[5].data || []);
    } catch (error) {
      setLoadError(error.message || "Couldn't load your library.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (session?.user?.id) loadData();
  }, [session?.user?.id]);

  const libraryItems = useMemo(() => {
    const items = [];

    books.forEach(book => {
      const matchingEditions = editions.filter(
        edition => edition.book_id === book.id
      );

      if (matchingEditions.length) {
        matchingEditions.forEach(edition => {
          items.push({
            ...book,
            editionRecord: edition,
            itemId: edition.id,
            isTbr: tbrIds.includes(book.id)
          });
        });
      } else {
        items.push({
          ...book,
          editionRecord: null,
          itemId: book.id,
          isTbr: tbrIds.includes(book.id)
        });
      }
    });

    return items;
  }, [books, editions, tbrIds]);

  const filtered = libraryItems.filter(item => {
    const matchesTbr = tab !== "TBR" || item.isTbr;
    const text = [
      item.title,
      item.author,
      item.genre,
      item.editionRecord?.format,
      item.editionRecord?.edition_name
    ].join(" ").toLowerCase();

    return matchesTbr && text.includes(search.toLowerCase());
  });

  const totalSpend = useMemo(
    () => preorders.reduce((sum, item) => sum + (Number(item.price) || 0), 0),
    [preorders]
  );

  // Open barcode scanner
  async function openScanner() {
    try {
      if (!cameraPermission?.granted) {
        const permission = await requestCameraPermission();

        if (!permission.granted) {
          Alert.alert(
            "Camera permission needed",
            "Please allow Folio to use your camera so it can scan book barcodes."
          );
          return;
        }
      }

      setBarcodeScanned(false);
      setScannerVisible(true);
    } catch (error) {
      Alert.alert("Camera unavailable", error.message || "Please try again.");
    }
  }

  // Automatically look up a book after scanning its barcode
  async function handleBarcodeScanned(result) {
    if (barcodeScanned) return;

    const isbn = String(result.data || "").replace(/[^0-9Xx]/g, "");

    if (!isbn) {
      Alert.alert(
        "Barcode not recognised",
        "Please try scanning the barcode again."
      );
      return;
    }

    setBarcodeScanned(true);
    setBF("isbn", isbn);
    setScannerVisible(false);

    await lookupBook(isbn);
  }

  // Search Google Books and Open Library
  async function lookupBook(isbnOverride = "") {
    const isbn = (isbnOverride || bookForm.isbn || "").trim();
    const title = (bookForm.title || "").trim();
    const author = (bookForm.author || "").trim();

    if (!isbn && !title) {
      Alert.alert("Enter a title or ISBN", "Enter a book title or ISBN first.");
      return;
    }

    setLookupBusy(true);
    setLookupMessage("Searching book databases...");

    try {
      let googleInfo = null;
      let openInfo = null;
      let foundIsbn = "";
      let foundGenre = "";
      let openDescription = "";
      let openCover = "";

      const googleQuery = isbn
        ? "isbn:" + isbn
        : "intitle:" + title + (author ? "+inauthor:" + author : "");

      const googleUrl =
        "https://www.googleapis.com/books/v1/volumes?q=" +
        encodeURIComponent(googleQuery) + "&maxResults=10";

      try {
        const googleResponse = await fetch(googleUrl);

        if (googleResponse.ok) {
          const googleData = await googleResponse.json();
          const candidates = (googleData.items || [])
            .map(item => item.volumeInfo)
            .filter(Boolean)
            .sort((a, b) => googleCompleteness(b) - googleCompleteness(a));

          googleInfo = candidates[0] || null;

          if (googleInfo) {
            foundIsbn = getGoogleIsbn(googleInfo);
            foundGenre = (googleInfo.categories || []).join(", ");
          }
        }
      } catch (error) {
        console.log("Google Books lookup:", error.message);
      }

      try {
        const openQuery = isbn
          ? "isbn=" + encodeURIComponent(isbn)
          : "title=" + encodeURIComponent(title) +
            (author ? "&author=" + encodeURIComponent(author) : "");

        const openResponse = await fetch(
          "https://openlibrary.org/search.json?" + openQuery + "&limit=5"
        );

        if (openResponse.ok) {
          const openData = await openResponse.json();
          const result = openData.docs?.[0];

          if (result) {
            openInfo = {
              title: result.title || "",
              authors: result.author_name || [],
              publisher: result.publisher?.[0] || "",
              publishedDate: result.first_publish_year
                ? String(result.first_publish_year)
                : "",
              isbn: result.isbn?.find(x => x.length === 13) ||
                result.isbn?.[0] || "",
              genre: (result.subject || []).slice(0, 8).join(", "),
              pageCount: result.number_of_pages_median || "",
              cover: result.cover_i
                ? "https://covers.openlibrary.org/b/id/" + result.cover_i + "-L.jpg"
                : "",
              workKey: result.key || ""
            };

            if (!foundIsbn) foundIsbn = openInfo.isbn;
            if (!foundGenre) foundGenre = openInfo.genre;
            if (!openCover) openCover = openInfo.cover;

            if (result.key && !googleInfo?.description) {
              try {
                const workResponse = await fetch(
                  "https://openlibrary.org" + result.key + ".json"
                );

                if (workResponse.ok) {
                  const workData = await workResponse.json();
                  const description = workData.description;

                  openDescription = typeof description === "string"
                    ? description
                    : description?.value || "";
                }
              } catch (error) {
                console.log("Open Library description:", error.message);
              }
            }
          }
        }
      } catch (error) {
        console.log("Open Library lookup:", error.message);
      }

      if (!googleInfo && !openInfo) {
        setLookupMessage(
          "No match found in either book database. You can still enter the details manually."
        );
        Alert.alert(
          "Book not found",
          "I couldn't find this ISBN in either book database. You can enter the details manually."
        );
        return;
      }

      const bestTitle =
        googleInfo?.title || openInfo?.title || title;

      const bestAuthor =
        googleInfo?.authors?.length
          ? googleInfo.authors.join(", ")
          : openInfo?.authors?.join(", ") || author;

      const googleImage =
        googleInfo?.imageLinks?.thumbnail ||
        googleInfo?.imageLinks?.smallThumbnail ||
        "";

      const bestCover = cleanImageUrl(googleImage || openCover);

      const bestDescription =
        (typeof googleInfo?.description === "string"
          ? googleInfo.description
          : googleInfo?.description?.value) ||
        openDescription ||
        "";

      const bestPublisher =
        googleInfo?.publisher ||
        openInfo?.publisher ||
        "";

      const bestPublicationDate =
        googleInfo?.publishedDate ||
        openInfo?.publishedDate ||
        "";

      const bestGenre =
        foundGenre ||
        (googleInfo?.categories || []).join(", ") ||
        openInfo?.genre ||
        "";

      setBookForm(previous => ({
        ...previous,
        title: bestTitle || previous.title || "",
        author: bestAuthor || previous.author || "",
        isbn: foundIsbn || previous.isbn || isbn,
        description: bestDescription || previous.description || "",
        publisher: bestPublisher || previous.publisher || "",
        publicationDate: bestPublicationDate || previous.publicationDate || "",
        genre: bestGenre || previous.genre || "",
        cover: bestCover || previous.cover || ""
      }));

      const detailsFound = [
        bestAuthor,
        foundIsbn,
        bestDescription,
        bestPublisher,
        bestPublicationDate,
        bestGenre,
        bestCover
      ].filter(Boolean).length;

      if (detailsFound >= 5) {
        setLookupMessage("Book found! I've filled in the details I could find. Please check them before saving.");
      } else {
        setLookupMessage("I found the book, but the databases don't have every detail for this edition. I've filled in everything available.");
      }

      Alert.alert(
        "Book found!",
        "I've filled in the information available. Please check the details before saving."
      );
    } catch (error) {
      console.log("Book lookup error:", error.message);
      setLookupMessage(
        "Book search is unavailable right now. Please try again or enter the details manually."
      );
    } finally {
      setLookupBusy(false);
    }
  }

  function openBook() {
    setEditingItem(null);
    setBookForm({
      title: "",
      author: "",
      isbn: "",
      description: "",
      genre: "",
      format: "Hardback",
      editionName: "Standard",
      publisher: "",
      publicationDate: "",
      cover: "",
      signed: false,
      numbered: false,
      notes: "",
      tbr: false
    });
    setLookupMessage("");
    setModal("book");
  }

  function editBook(item) {
    const edition = item.editionRecord || {};

    setEditingItem(item);
    setBookForm({
      title: item.title || "",
      author: item.author || "",
      isbn: edition.isbn || "",
      description: item.description || "",
      genre: item.genre || "",
      format: edition.format || "Hardback",
      editionName: edition.edition_name || "Standard",
      publisher: edition.publisher || "",
      publicationDate: edition.publication_date || "",
      cover: edition.cover_url || item.cover_url || "",
      signed: !!edition.signed,
      numbered: !!edition.numbered,
      notes: edition.notes || "",
      tbr: !!item.isTbr
    });
    setLookupMessage("");
    setSelectedItem(null);
    setModal("book");
  }

  async function saveBook() {
    if (!bookForm.title?.trim()) {
      Alert.alert("Add a title", "Please enter the book title.");
      return;
    }

    if (!session?.user?.id) return;

    setSaving(true);

    try {
      const userId = session.user.id;
      const title = bookForm.title.trim();
      const author = (bookForm.author || "").trim();

      let bookId;
      let editionId;

      if (editingItem) {
        bookId = editingItem.id;
        editionId = editingItem.editionRecord?.id || null;

        const { error: bookError } = await supabase
          .from("books")
          .update({
            title,
            author: author || null,
            description: bookForm.description || null,
            genre: bookForm.genre || null,
            cover_url: bookForm.cover || null
          })
          .eq("id", bookId)
          .eq("user_id", userId);

        if (bookError) throw bookError;

        if (editionId) {
          const { error: editionError } = await supabase
            .from("editions")
            .update({
              isbn: bookForm.isbn || null,
              format: bookForm.format || null,
              edition_name: bookForm.editionName || "Standard",
              publisher: bookForm.publisher || null,
              publication_date: bookForm.publicationDate || null,
              cover_url: bookForm.cover || null,
              signed: !!bookForm.signed,
              numbered: !!bookForm.numbered,
              notes: bookForm.notes || null
            })
            .eq("id", editionId)
            .eq("user_id", userId);

          if (editionError) throw editionError;
        }
      } else {
        const { data: existing, error: findError } = await supabase
          .from("books")
          .select("id")
          .eq("user_id", userId)
          .eq("title", title)
          .eq("author", author)
          .limit(1)
          .maybeSingle();

        if (findError) throw findError;

        bookId = existing?.id;

        if (!bookId) {
          const { data: newBook, error: bookError } = await supabase
            .from("books")
            .insert({
              user_id: userId,
              title,
              author: author || null,
              description: bookForm.description || null,
              genre: bookForm.genre || null,
              cover_url: bookForm.cover || null
            })
            .select("id")
            .single();

          if (bookError) throw bookError;
          bookId = newBook.id;
        } else {
          const { error: updateError } = await supabase
            .from("books")
            .update({
              description: bookForm.description || null,
              genre: bookForm.genre || null,
              cover_url: bookForm.cover || null
            })
            .eq("id", bookId)
            .eq("user_id", userId);

          if (updateError) throw updateError;
        }

        const { data: newEdition, error: editionError } = await supabase
          .from("editions")
          .insert({
            book_id: bookId,
            user_id: userId,
            isbn: bookForm.isbn || null,
            format: bookForm.format || null,
            edition_name: bookForm.editionName || "Standard",
            publisher: bookForm.publisher || null,
            publication_date: bookForm.publicationDate || null,
            cover_url: bookForm.cover || null,
            special_features: null,
            signed: !!bookForm.signed,
            numbered: !!bookForm.numbered,
            price: null,
            purchase_date: null,
            notes: bookForm.notes || null
          })
          .select("id")
          .single();

        if (editionError) throw editionError;

        const { error: copyError } = await supabase
          .from("physical_copies")
          .insert({
            edition_id: newEdition.id,
            user_id: userId,
            signed: !!bookForm.signed,
            numbered: !!bookForm.numbered,
            purchase_date: null,
            notes: bookForm.notes || null
          });

        if (copyError) throw copyError;
      }

      if (bookForm.tbr && !tbrIds.includes(bookId)) {
        const { error } = await supabase
          .from("tbr_books")
          .insert({ user_id: userId, book_id: bookId });

        if (error) throw error;
      } else if (!bookForm.tbr && tbrIds.includes(bookId)) {
        const { error } = await supabase
          .from("tbr_books")
          .delete()
          .eq("user_id", userId)
          .eq("book_id", bookId);

        if (error) throw error;
      }

      setModal("");
      setEditingItem(null);
      await loadData();

      Alert.alert(
        editingItem ? "Details updated" : "Saved to your library",
        editingItem ? "Your book details have been updated." : "Your book, edition and first physical copy have been saved."
      );
    } catch (error) {
      Alert.alert("Couldn't save the book", error.message || "Please try again.");
    } finally {
      setSaving(false);
    }
  }

  async function toggleTbr(bookId, currentlyOnTbr) {
    if (!session?.user?.id) return;

    try {
      if (currentlyOnTbr) {
        const { error } = await supabase
          .from("tbr_books")
          .delete()
          .eq("user_id", session.user.id)
          .eq("book_id", bookId);

        if (error) throw error;
      } else {
        const { error } = await supabase
          .from("tbr_books")
          .insert({ user_id: session.user.id, book_id: bookId });

        if (error) throw error;
      }

      await loadData();
    } catch (error) {
      Alert.alert("Couldn't update your TBR", error.message);
    }
  }

  function openCollection() {
    setCollectionForm({ name: "", description: "" });
    setModal("collection");
  }

  async function saveCollection() {
    if (!collectionForm.name?.trim()) {
      Alert.alert("Add a name", "Please enter a name for your collection.");
      return;
    }

    setSaving(true);

    try {
      const { error } = await supabase.from("collections").insert({
        user_id: session.user.id,
        name: collectionForm.name.trim(),
        description: collectionForm.description || null,
        is_public: false
      });

      if (error) throw error;

      setModal("");
      await loadData();
      Alert.alert("Collection created", "Your new collection has been saved.");
    } catch (error) {
      Alert.alert("Couldn't create collection", error.message);
    } finally {
      setSaving(false);
    }
  }

  async function addBookToCollection(collectionId, bookId) {
    if (!session?.user?.id || !collectionId || !bookId) return;

    try {
      const { error } = await supabase.from("collection_books").upsert(
        {
          user_id: session.user.id,
          collection_id: collectionId,
          book_id: bookId
        },
        { onConflict: "collection_id,book_id" }
      );

      if (error) throw error;

      const { data, error: loadError } = await supabase
        .from("collection_books")
        .select("collection_id, book_id")
        .eq("user_id", session.user.id);

      if (loadError) throw loadError;

      setCollectionBooks(data || []);
      Alert.alert("Added to collection", "Your book has been added.");
    } catch (error) {
      Alert.alert("Couldn't add book", error.message);
    }
  }
  function openPreorder() {
    setPreForm({
      title: "",
      author: "",
      publisher: "",
      format: "Hardback",
      isbn: "",
      retailer: "",
      price: "",
      currency: "GBP",
      status: "Ordered",
      purchaseDate: "",
      releaseDate: "",
      notes: "",
      cover: ""
    });
    setModal("preorder");
  }

  async function savePreorder() {
    if (!preForm.title?.trim()) {
      Alert.alert("Add a title", "Please enter the book title.");
      return;
    }

    const price = preForm.price ? Number(preForm.price) : null;

    if (price !== null && (!Number.isFinite(price) || price < 0)) {
      Alert.alert("Check the price", "Please enter a valid amount.");
      return;
    }

    setSaving(true);

    try {
      const { error } = await supabase.from("preorders").insert({
        user_id: session.user.id,
        title: preForm.title.trim(),
        author: preForm.author || null,
        publisher: preForm.publisher || null,
        format: preForm.format || null,
        isbn: preForm.isbn || null,
        cover_url: preForm.cover || null,
        retailer: preForm.retailer || null,
        price,
        currency: "GBP",
        status: preForm.status || "Ordered",
        order_date: preForm.purchaseDate || null,
        release_date: preForm.releaseDate || null,
        notes: preForm.notes || null
      });

      if (error) throw error;

      setModal("");
      await loadData();
      Alert.alert("Pre-order saved", "Your pre-order has been saved.");
    } catch (error) {
      Alert.alert("Couldn't save pre-order", error.message);
    } finally {
      setSaving(false);
    }
  }

  async function updatePreorder(item) {
    const nextStatus = item.status === "Ordered" ? "Shipped" : "Received";

    if (nextStatus === "Received") {
      Alert.alert(
        "Mark as received?",
        "This will add the book to your Library. You can then add its edition details.",
        [
          { text: "Cancel", style: "cancel" },
          {
            text: "Mark received",
            onPress: async () => {
              try {
                const { error } = await supabase
                  .from("preorders")
                  .update({ status: "Received" })
                  .eq("id", item.id)
                  .eq("user_id", session.user.id);

                if (error) throw error;

                const { data: existing, error: findError } = await supabase
                  .from("books")
                  .select("id")
                  .eq("user_id", session.user.id)
                  .eq("title", item.title)
                  .eq("author", item.author || "")
                  .limit(1)
                  .maybeSingle();

                if (findError) throw findError;

                if (!existing) {
                  const { error: addError } = await supabase.from("books").insert({
                    user_id: session.user.id,
                    title: item.title,
                    author: item.author || null,
                    cover_url: item.cover_url || null
                  });

                  if (addError) throw addError;
                }

                await loadData();
                setTab("Library");
                Alert.alert("Added to Library", "Your book is ready for its edition details.");
              } catch (error) {
                Alert.alert("Couldn't update pre-order", error.message);
              }
            }
          }
        ]
      );
      return;
    }

    try {
      const { error } = await supabase
        .from("preorders")
        .update({ status: nextStatus })
        .eq("id", item.id)
        .eq("user_id", session.user.id);

      if (error) throw error;
      await loadData();
    } catch (error) {
      Alert.alert("Couldn't update pre-order", error.message);
    }
  }

  async function removePreorder(item) {
    Alert.alert("Remove pre-order?", "This will remove it from your pre-order list.", [
      { text: "Cancel", style: "cancel" },
      {
        text: "Remove",
        style: "destructive",
        onPress: async () => {
          try {
            const { error } = await supabase
              .from("preorders")
              .delete()
              .eq("id", item.id)
              .eq("user_id", session.user.id);

            if (error) throw error;
            await loadData();
          } catch (error) {
            Alert.alert("Couldn't remove pre-order", error.message);
          }
        }
      }
    ]);
  }

  // Profile screen
  async function openProfile() {
    setModal("profile");
    setProfileLoading(true);

    try {
      const { data, error } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", session.user.id)
        .maybeSingle();

      if (error) throw error;

      setProfile(data || null);
      setNewUsername(data?.username || "");
    } catch (error) {
      Alert.alert("Couldn't load profile", error.message);
    } finally {
      setProfileLoading(false);
    }
  }

  async function saveUsername() {
    const username = newUsername.trim();

    if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
      Alert.alert(
        "Check your username",
        "Your username must be 3â€“20 characters and use only letters, numbers and underscores."
      );
      return;
    }

    if (!session?.user?.id) return;

    if (username.toLowerCase() === String(profile?.username || "").toLowerCase()) {
      Alert.alert("No change needed", "That is already your username.");
      return;
    }

    setUsernameSaving(true);

    try {
      const { data: updatedProfile, error } = await supabase
        .from("profiles")
        .update({ username })
        .eq("id", session.user.id)
        .select("*")
        .single();

      if (error) {
        if (error.code === "23505") {
          throw new Error("That username is already taken. Please choose another one.");
        }
        throw error;
      }

      setProfile(updatedProfile);
      setNewUsername(updatedProfile.username || username);
      Alert.alert("Username updated", "Your new username has been saved.");
    } catch (error) {
      Alert.alert("Couldn't change username", error.message || "Please try again.");
    } finally {
      setUsernameSaving(false);
    }
  }

  async function signOut() {
    Alert.alert("Sign out?", "Are you sure you want to sign out of Folio?", [
      { text: "Cancel", style: "cancel" },
      {
        text: "Sign out",
        style: "destructive",
        onPress: async () => {
          const { error } = await supabase.auth.signOut();
          if (error) Alert.alert("Couldn't sign out", error.message);
          else setModal("");
        }
      }
    ]);
  }

  const tabs = ["Library", "Collections", "TBR", "Pre-orders", "Stats"];

  if (authLoading) {
    return (
      <SafeAreaView style={{
        flex: 1,
        backgroundColor: C.bg,
        justifyContent: "center",
        alignItems: "center"
      }}>
        <ActivityIndicator color={C.burgundy} size="large" />
