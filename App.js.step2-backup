            top: "42%",
            height: 110,
            borderWidth: 2,
            borderColor: "#FFFFFF",
            borderRadius: 12
          }} pointerEvents="none" />
        </View>
      </Modal>

      {/* Profile */}
      <Modal
        visible={modal === "profile"}
        animationType="slide"
        transparent
        onRequestClose={() => setModal("")}
      >
        <View style={{ flex: 1, backgroundColor: "#0009", justifyContent: "flex-end" }}>
          <View style={{
            backgroundColor: C.card,
            borderTopLeftRadius: 24,
            borderTopRightRadius: 24,
            padding: 20,
            maxHeight: "85%"
          }}>
            <ScrollView keyboardShouldPersistTaps="handled">
              <Text style={{
                fontSize: 23,
                fontWeight: "700",
                color: C.ink,
                marginBottom: 8
              }}>
                Your profile
              </Text>

              {profileLoading ? (
                <View style={{ padding: 25, alignItems: "center" }}>
                  <ActivityIndicator color={C.burgundy} size="large" />
                  <Text style={{ color: C.muted, marginTop: 10 }}>
                    Loading your profile...
                  </Text>
                </View>
              ) : (
                <>
                  <Text style={{ color: C.muted, fontSize: 12, marginBottom: 5 }}>
                    Your email address
                  </Text>
                  <Text style={{ color: C.ink, fontSize: 15, marginBottom: 18 }}>
                    {session.user.email || "Not available"}
                  </Text>

                  <Text style={{
                    color: C.ink,
                    fontWeight: "700",
                    fontSize: 16,
                    marginBottom: 8
                  }}>
                    Change username
                  </Text>

                  <Text style={{
                    color: C.muted,
                    fontSize: 12,
                    lineHeight: 18,
                    marginBottom: 12
                  }}>
                    Your username is how other people can find your profile if you enable social features. It must be unique.
                  </Text>

                  <Field
                    label="Username"
                    value={newUsername}
                    onChangeText={setNewUsername}
                    placeholder="Choose a username"
                    autoCapitalize="none"
                  />

                  <Text style={{
                    color: C.muted,
                    fontSize: 11,
                    marginTop: -5,
                    marginBottom: 14
                  }}>
                    Use 3â€“20 letters, numbers or underscores. No spaces.
                  </Text>

                  <Action
                    title={usernameSaving ? "Saving username..." : "Save new username"}
                    primary
                    onPress={saveUsername}
                    disabled={usernameSaving || profileLoading}
                  />

                  {!profile && (
                    <Text style={{
                      color: C.muted,
                      fontSize: 12,
                      marginTop: 12
                    }}>
                      No profile record was found for this account. If you cannot save a username, let me know and we'll check the profile setup.
                    </Text>
                  )}

                  <View style={{ height: 18 }} />
                  <View style={{
                    height: 1,
                    backgroundColor: C.line,
                    marginBottom: 18
                  }} />

                  <Action title="Sign out" onPress={signOut} />
                </>
              )}

              <View style={{ height: 10 }} />
              <Action title="Close" onPress={() => setModal("")} />
              <View style={{ height: 15 }} />
            </ScrollView>
          </View>
        </View>
      </Modal>

      {/* Add collection */}
      <Modal visible={modal === "collection"} animationType="slide" transparent onRequestClose={() => setModal("")}>
        <View style={{ flex: 1, backgroundColor: "#0009", justifyContent: "flex-end" }}>
          <KeyboardAvoidingView behavior={Platform.OS === "ios" ? "padding" : undefined}>
            <View style={{
              backgroundColor: C.card,
              borderTopLeftRadius: 24,
              borderTopRightRadius: 24,
              padding: 20,
              maxHeight: "85%"
            }}>
              <ScrollView keyboardShouldPersistTaps="handled">
                <Text style={{ fontSize: 22, fontWeight: "700", color: C.ink, marginBottom: 16 }}>
                  Create a collection
                </Text>
                <Field label="Collection name" value={collectionForm.name} onChangeText={v => setCF("name", v)} />
                <Field label="Description (optional)" value={collectionForm.description} onChangeText={v => setCF("description", v)} multiline />
                <Action title={saving ? "Saving..." : "Create collection"} primary onPress={saveCollection} disabled={saving} />
                <View style={{ height: 10 }} />
                <Action title="Cancel" onPress={() => setModal("")} />
                <View style={{ height: 20 }} />
              </ScrollView>
            </View>
          </KeyboardAvoidingView>
        </View>
      </Modal>

      {/* Add pre-order */}
      <Modal visible={modal === "preorder"} animationType="slide" transparent onRequestClose={() => setModal("")}>
        <View style={{ flex: 1, backgroundColor: "#0009", justifyContent: "flex-end" }}>
          <KeyboardAvoidingView behavior={Platform.OS === "ios" ? "padding" : undefined}>
            <View style={{
              backgroundColor: C.card,
              borderTopLeftRadius: 24,
              borderTopRightRadius: 24,
              padding: 20,
              maxHeight: "94%"
            }}>
              <ScrollView keyboardShouldPersistTaps="handled">
                <Text style={{ fontSize: 22, fontWeight: "700", color: C.ink, marginBottom: 16 }}>
                  Add a pre-order
                </Text>
                <Field label="Book title" value={preForm.title} onChangeText={v => setPF("title", v)} />
                <Field label="Author" value={preForm.author} onChangeText={v => setPF("author", v)} />
                <Field label="Publisher" value={preForm.publisher} onChangeText={v => setPF("publisher", v)} />
                <Field label="ISBN" value={preForm.isbn} onChangeText={v => setPF("isbn", v)} />
                <Choice label="Format" value={preForm.format || "Hardback"} options={["Hardback", "Paperback", "Audiobook", "Ebook"]} onChange={v => setPF("format", v)} />
                <Field label="Retailer / bookshop" value={preForm.retailer} onChangeText={v => setPF("retailer", v)} />
                <Field label="Price paid (Â£)" value={preForm.price} onChangeText={v => setPF("price", v)} keyboardType="decimal-pad" />
                <Field label="Purchase date (YYYY-MM-DD)" value={preForm.purchaseDate} onChangeText={v => setPF("purchaseDate", v)} placeholder="2026-11-02" />
                <Field label="Expected release date (YYYY-MM-DD)" value={preForm.releaseDate} onChangeText={v => setPF("releaseDate", v)} />
                <Choice label="Order status" value={preForm.status || "Ordered"} options={["Ordered", "Shipped"]} onChange={v => setPF("status", v)} />
                <Field label="Notes" value={preForm.notes} onChangeText={v => setPF("notes", v)} multiline />
                <Action title={saving ? "Saving..." : "Save pre-order"} primary onPress={savePreorder} disabled={saving} />
                <View style={{ height: 10 }} />
                <Action title="Cancel" onPress={() => setModal("")} />
                <View style={{ height: 20 }} />
              </ScrollView>
            </View>
          </KeyboardAvoidingView>
        </View>
      </Modal>

      {/* Book and edition details */}
      <Modal visible={!!selectedItem} animationType="slide" transparent onRequestClose={() => setSelectedItem(null)}>
        <View style={{ flex: 1, backgroundColor: "#0009", justifyContent: "flex-end" }}>
          <View style={{
            backgroundColor: C.card,
            borderTopLeftRadius: 24,
            borderTopRightRadius: 24,
            padding: 20,
            maxHeight: "90%"
          }}>
            <ScrollView>
              {!!selectedItem && (
                <>
                  <View style={{ alignItems: "center" }}>
                    <Cover
                      uri={selectedItem.editionRecord?.cover_url || selectedItem.cover_url}
                      title={selectedItem.title}
                      style={{ width: 150 }}
                    />
                  </View>
                  <Text style={{ color: C.ink, fontSize: 23, fontWeight: "700", marginTop: 16 }}>
                    {selectedItem.title}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 4 }}>
                    {selectedItem.author}
                  </Text>
                  {!!selectedItem.description && (
                    <Text style={{ color: C.ink, lineHeight: 21, marginTop: 14 }}>
                      {selectedItem.description}
                    </Text>
                  )}
                  <View style={{ height: 16 }} />
                  <Text style={{ color: C.ink, fontWeight: "700", fontSize: 16 }}>
                    Edition details
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 8 }}>
                    Format: {selectedItem.editionRecord?.format || "Not specified"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    Edition: {selectedItem.editionRecord?.edition_name || "Not specified"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    ISBN: {selectedItem.editionRecord?.isbn || "Not specified"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    Publisher: {selectedItem.editionRecord?.publisher || "Not specified"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    Publication date: {selectedItem.editionRecord?.publication_date || "Not specified"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    Signed: {selectedItem.editionRecord?.signed ? "Yes" : "No"}
                  </Text>
                  <Text style={{ color: C.muted, marginTop: 5 }}>
                    Numbered: {selectedItem.editionRecord?.numbered ? "Yes" : "No"}
                  </Text>
                  {!!selectedItem.editionRecord?.notes && (
                    <Text style={{ color: C.muted, marginTop: 10 }}>
                      Notes: {selectedItem.editionRecord.notes}
                    </Text>
                  )}
                  <View style={{ marginTop: 18, marginBottom: 8 }}>
                    <Text style={{ color: C.ink, fontWeight: "700", fontSize: 16, marginBottom: 10 }}>
                      Collections
                    </Text>

                    {collections.length === 0 ? (
                      <Text style={{ color: C.muted, fontSize: 13 }}>
                        Create a collection first to organise this book.
                      </Text>
                    ) : collections.map(collection => {
                      const alreadyAdded = collectionBooks.some(
                        link =>
                          link.collection_id === collection.id &&
                          link.book_id === selectedItem.id
                      );

                      return (
                        <Action
                          key={collection.id}
                          title={alreadyAdded ? "Added to " + collection.name : "Add to " + collection.name}
                          onPress={() => addBookToCollection(collection.id, selectedItem.id)}
                          disabled={alreadyAdded}
                        />
                      );
                    })}
                  </View>
                  <View style={{ marginTop: 18, gap: 9 }}>
                    <Action
                      title="Edit details"
                      primary
                      onPress={() => editBook(selectedItem)}
                    />
                    <Action
                      title={selectedItem.isTbr ? "Remove from TBR" : "Add to TBR"}
                      onPress={async () => {
                        await toggleTbr(selectedItem.id, selectedItem.isTbr);
                        setSelectedItem(null);
                      }}
                    />
                  </View>
                </>
              )}
              <View style={{ height: 10 }} />
              <Action title="Close" onPress={() => setSelectedItem(null)} />
              <View style={{ height: 20 }} />
            </ScrollView>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}



